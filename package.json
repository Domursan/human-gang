{
  "name": "human-gang",
  "version": "0.0.0",
  "private": true,
  "description": "Site du Humane Gang : tests et vérifications statiques (le site lui-même n'a pas de build)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node tests/check-js.cjs && node tests/check-publication.cjs",
    "test:rpc": "node tests/check-rpc.mjs",
    "test:smoke": "node tests/smoke.cjs && node tests/smoke-admin.cjs",
    "test": "node tests/run-all.cjs",
    "test:a11y": "node tests/a11y-pages.cjs",
    "test:perf": "node tests/perf-budget.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "playwright": "1.56.0"
  }
}
